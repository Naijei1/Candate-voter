# Optional path prefix. Leave empty for the voter.naijei.com subdomain.
# Set to /voter only if this app is later served under that path (CloudFront).
# Must be present at `next build` time. In Amplify, set it as an environment variable.
NEXT_PUBLIC_BASE_PATH=

# Server-side AWS settings. Do not put secret values in this file.
# Both have code defaults (us-east-1 and candate-voter). Set them to use a
# different region or table. The Amplify build writes CANDATE_TABLE_NAME,
# CANDATE_API_KEY, CANDATE_CYCLES, AWS_REGION, and NEXT_PUBLIC_* into
# .env.production so the Next.js server can read them. It does not copy
# FEC_API_KEY. Never commit a key.
AWS_REGION=us-east-1
CANDATE_TABLE_NAME=candate-voter
# Optional home-index years. When unset, the page queries the previous UTC
# calendar year through six years ahead.
# CANDATE_CYCLES=2026,2027,2028

# Read API key for /api/v1. HTML pages, including /agent, do not use it.
# Clients send it as `Authorization: Bearer <key>` or `X-Api-Key: <key>`.
# Generate a long random value. Never commit it. On Amplify, set it as a
# branch environment variable. amplify.yml copies it into .env.production
# so the Next.js server can read it at runtime. Changing it requires a rebuild.
# CANDATE_API_KEY=

# Browser chat, POST /api/chat. Off until CANDATE_CHAT_ENABLED is true.
# Bedrock uses the Amplify compute role (bedrock:Converse and
# bedrock:InvokeModel). Do not put a model key in NEXT_PUBLIC_* or in this
# file. Defaults are the US geo profiles for Claude Haiku 5.5 and, when
# CANDATE_CHAT_MODEL=sonnet, Claude Sonnet 5.5. The in-memory rate limit is
# per server instance.
# CANDATE_CHAT_ENABLED=true
# Explicit "whose views align with mine" answers. Unset means on.
# The handler still refuses to invent positions: filings have no vote text.
# CANDATE_CHAT_ALIGNMENT=true
# CANDATE_CHAT_MODEL=haiku
# CANDATE_CHAT_RATE_LIMIT=20
# CANDATE_CHAT_RATE_WINDOW_SECONDS=60
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
# BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-5-5

# OpenFEC requires an api.data.gov key as the api_key query parameter.
# DEMO_KEY is the public demo key (about 10 calls/hour, shared). A free key
# from https://api.data.gov/signup/ allows 1,000 calls/hour. Leave this empty
# in the example file.
# FEC_API_KEY=
# Optional override. Default is https://api.open.fec.gov/v1
# FEC_API_BASE_URL=https://api.open.fec.gov/v1
