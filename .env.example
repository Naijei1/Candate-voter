# Optional path prefix. Leave empty for the voter.naijei.com subdomain.
# Set to /voter only if this app is later served under that path (CloudFront).
# Must be present at `next build` time. In Amplify, set it as an environment variable.
NEXT_PUBLIC_BASE_PATH=

# Future server-side AWS settings. Do not put secret values in this file.
# Set real values in Amplify environment variables or the runtime that runs ingest.
AWS_REGION=us-east-1
# DYNAMODB_RACES_TABLE=
# DYNAMODB_CANDIDATES_TABLE=
# DYNAMODB_FILINGS_TABLE=
# FEC_API_KEY=
